# Copie este arquivo para ".env" (uso local) ou configure as mesmas variáveis
# no painel do seu serviço de hospedagem (Render, Railway, Fly.io, etc).
# NENHUMA chave é obrigatória para o backend funcionar — sem elas, a análise
# usa só o sinal-base gratuito (domínio + heurísticas). Quanto mais chaves
# configuradas, mais preciso o resultado.

# Porta em que o servidor escuta (a maioria dos serviços de nuvem já define
# isso automaticamente via variável de ambiente PORT).
PORT=3000

# Origens extras permitidas por CORS, separadas por vírgula. Deixe em branco
# para aceitar automaticamente qualquer chrome-extension://, moz-extension://
# ou edge-extension:// (suficiente para a maioria dos casos). Só preencha se
# quiser travar para o ID específico da sua extensão publicada, ex.:
# ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnop,moz-extension://xxxxxxx-xxxx
ALLOWED_ORIGINS=

# Limite de requisições por IP a cada 15 minutos na rota /api/analyze.
RATE_LIMIT_MAX=60

# Chave gratuita do Google Fact Check Tools API. Ativa o sinal de checagem
# de fatos em tempo real (Aos Fatos, Lupa, Boatos.org e milhares de outras
# agências no mundo todo). Como obter: veja o passo a passo no README.md.
GOOGLE_FACT_CHECK_API_KEY=

# Chave da API da Anthropic (Claude). Ativa o sinal de leitura do texto pela
# IA. Tem custo pago por uso (poucos centavos por análise). Como obter: veja
# o passo a passo no README.md. NUNCA compartilhe esta chave publicamente.
ANTHROPIC_API_KEY=

# Opcional: sobrescreve o modelo padrão usado para a análise por IA.
# ANTHROPIC_MODEL=claude-opus-5
