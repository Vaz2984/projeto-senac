{
  "manifest_version": 3,
  "name": "FactAI — Detector de Fake News",
  "short_name": "FactAI",
  "version": "1.0.0",
  "description": "Semáforo de confiabilidade (verde/amarelo/vermelho) para notícias, combinando domínio, heurísticas, checagem de fatos e IA.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FactAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "scripts": ["src/browserApi.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/browserApi.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "factai@factai.app",
      "strict_min_version": "115.0"
    }
  }
}
